# SmartFarm 환경 설정
# 이 파일을 .env로 복사한 후 실제 값을 입력하세요.
# .env 파일은 .gitignore에 포함되어 있어 Git에 추적되지 않습니다.

# WiFi
WIFI_SSID=your_wifi_ssid
WIFI_PASS=your_wifi_password

# Network
MQTT_BROKER=192.168.5.22
MQTT_PORT=1883
NODE1_IP=192.168.5.91
NODE2_IP=192.168.5.92

# KMA Weather API
KMA_AUTH_KEY=your_kma_api_key
KMA_STATION_ID=146

# Greenhouse
GREENHOUSE_ID=gh1
